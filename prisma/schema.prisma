// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_DATABASE_URL")
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum SubscriptionPlan {
  BASIC
  FEATURED
}

model State {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cities City[]

  @@map("states")
}

model City {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  imageUrl    String?
  stateId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  state    State     @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, slug])
  @@map("cities")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent     Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[]  @relation("CategoryHierarchy")
  listings   ListingCategory[]

  @@map("categories")
}

model Listing {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?
  address         String
  city            String
  state           String
  zipCode         String?
  phone           String?
  website         String?
  email           String?
  latitude        Float?
  longitude       Float?
  placeId         String? // Google Places ID
  status          ListingStatus @default(PUBLISHED)
  
  // Business categorization
  primaryCategory String        @map("primary_category")
  categoriesArray String[]      @default([]) @map("categories_array") // Additional categories
  
  // Business metrics
  rating          Float?
  reviewsCount    Int?          @map("reviews_count")
  
  // Priority and featured listings
  priorityTier    Int           @default(1) @map("priority_tier")
  featuredUntil   DateTime?     @map("featured_until")
  
  // Google integration
  googleTypes     String[]      @default(["establishment"]) @map("google_types")
  
  // Images (Cloudinary URLs)
  thumbnails      String[]      @default([])
  
  // Private contact information (not displayed publicly)
  contactName     String?       @map("contact_name")
  contactEmail    String?       @map("contact_email")
  contactPhone    String?       @map("contact_phone")
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  categories ListingCategory[]
  media      Media[]
  subscription Subscription?

  @@map("listings")
}

model ListingCategory {
  id         String @id @default(cuid())
  listingId  String
  categoryId String
  createdAt  DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([listingId, categoryId])
  @@map("listing_categories")
}

model Media {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  listingId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("media")
}

model NewsletterSubscriber {
  id                String   @id @default(cuid())
  email             String   @unique
  firstName         String
  lastName          String
  subscribedAt      DateTime @default(now())
  isActive          Boolean  @default(true)
  unsubscribeToken  String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model Subscription {
  id                String            @id @default(cuid())
  paypalSubscriptionId String         @unique @map("paypal_subscription_id")
  businessId       String             @unique @map("business_id")
  businessName     String             @map("business_name")
  email            String
  status           SubscriptionStatus @default(ACTIVE)
  plan             SubscriptionPlan   @default(BASIC)
  amount           Float
  startDate        DateTime           @map("start_date")
  endDate          DateTime           @map("end_date")
  nextBillingDate  DateTime           @map("next_billing_date")
  lastPaymentDate  DateTime?          @map("last_payment_date")
  canceledDate     DateTime?          @map("canceled_date")
  autoRenew        Boolean            @default(true) @map("auto_renew")
  paypalCustomerId String?            @map("paypal_customer_id")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  business Listing @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}